# ---------------------------------------------------------------------------
# MasjidLuv — environment template
#
# Copy to `.env` and fill in real values:   cp .env.example .env
# `.env` is gitignored. This file is committed and must contain PLACEHOLDERS ONLY.
# ---------------------------------------------------------------------------

# --- Public: safe to ship in the client bundle -----------------------------
# Anything prefixed EXPO_PUBLIC_ is compiled into the JS bundle and is trivially
# extractable from a published web build. Only put values here that are designed
# to be public and are protected by RLS or by domain/URL restrictions.

# Supabase project URL (Dashboard > Project Settings > Data API)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/publishable key. Public by design; safety comes from RLS.
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Mapbox PUBLIC access token — must start with `pk.`, never `sk.`
# Restrict it by URL in the Mapbox dashboard.
EXPO_PUBLIC_MAPBOX_PUBLIC_TOKEN=pk.your-public-token-here


# --- Secrets: NEVER put these in this file, in `.env`, or in any ------------
# --- EXPO_PUBLIC_ variable. They live only in Edge Function secrets: -------
#
#   npx supabase secrets set OPENROUTER_API_KEY=...
#   npx supabase secrets set SUPABASE_SERVICE_ROLE_KEY=...
#
# Listed here as documentation of what exists, deliberately with no values:
#
#   SUPABASE_SERVICE_ROLE_KEY   - bypasses RLS entirely. Server-side only.
#   OPENROUTER_API_KEY          - OpenRouter key. Spends real money. Server-side only.
#   MAPBOX_SECRET_TOKEN         - Mapbox secret token, only if a build step needs it.
